{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "feature-start (platform)",
      "type": "shell",
      "command": "mvn",
      "args": [
        "gitflow:feature-start"
      ],
      "options": {
        "cwd": "${workspaceFolder}/platform"
      },
      "group": "build",
      "problemMatcher": {
        "owner": "external-maven",
        "fileLocation": [
          "absolute"
        ],
        "pattern": {
          "regexp": "^\\[ERROR\\]\\s+(.*):\\[(\\d+),(\\d+)\\]\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      }
    },
    {
      "label": "feature-finish (platform)",
      "type": "shell",
      "command": "mvn",
      "args": [
        "gitflow:feature-finish"
      ],
      "options": {
        "cwd": "${workspaceFolder}/platform"
      },
      "group": "build",
      "problemMatcher": {
        "owner": "external-maven",
        "fileLocation": [
          "absolute"
        ],
        "pattern": {
          "regexp": "^\\[ERROR\\]\\s+(.*):\\[(\\d+),(\\d+)\\]\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      }
    },
    {
      "label": "feature-start (demo)",
      "type": "shell",
      "command": "mvn",
      "args": [
        "gitflow:feature-start"
      ],
      "options": {
        "cwd": "${workspaceFolder}/demo"
      },
      "group": "build",
      "problemMatcher": {
        "owner": "external-maven",
        "fileLocation": [
          "absolute"
        ],
        "pattern": {
          "regexp": "^\\[ERROR\\]\\s+(.*):\\[(\\d+),(\\d+)\\]\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      }
    },
    {
      "label": "feature-finish (demo)",
      "type": "shell",
      "command": "mvn",
      "args": [
        "gitflow:feature-finish"
      ],
      "options": {
        "cwd": "${workspaceFolder}/demo"
      },
      "group": "build",
      "problemMatcher": {
        "owner": "external-maven",
        "fileLocation": [
          "absolute"
        ],
        "pattern": {
          "regexp": "^\\[ERROR\\]\\s+(.*):\\[(\\d+),(\\d+)\\]\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      }
    },
    {
      "label": "build (platform)",
      "type": "shell",
      "command": "mvn",
      "args": [
        "clean",
        "install",
        "-DskipTests"
      ],
      "options": {
        "cwd": "${workspaceFolder}/platform"
      },
      "group": "build",
      "problemMatcher": {
        "owner": "external-maven",
        "fileLocation": [
          "absolute"
        ],
        "pattern": {
          "regexp": "^\\[ERROR\\]\\s+(.*):\\[(\\d+),(\\d+)\\]\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      }
    },
    {
      "label": "build (demo)",
      "type": "shell",
      "command": "mvn",
      "args": [
        "clean",
        "install",
        "-DskipTests"
      ],
      "options": {
        "cwd": "${workspaceFolder}/demo"
      },
      "group": "build",
      "problemMatcher": {
        "owner": "external-maven",
        "fileLocation": [
          "absolute"
        ],
        "pattern": {
          "regexp": "^\\[ERROR\\]\\s+(.*):\\[(\\d+),(\\d+)\\]\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      }
    },
    {
      "label": "build",
      "dependsOrder": "sequence",
      "dependsOn": [
        "build (platform)",
        "build (demo)"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "verify",
      "type": "shell",
      "command": "mvn -B verify",
      "group": "build"
    },
    {
      "label": "test",
      "type": "shell",
      "command": "mvn -B test",
      "group": "test"
    },
    {
      "label": "db (delete)",
      "type": "shell",
      "command": "mvn",
      "args": [
        "install",
        "exec:exec@dropAll",
        "-DskipTests"
      ],
      "options": {
        "cwd": "${workspaceFolder}/platform/tailoringexpert-db"
      },
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "db (tailoringexpert)",
      "type": "shell",
      "command": "mvn",
      "args": [
        "install",
        "exec:exec@update",
        "-DskipTests"
      ],
      "options": {
        "cwd": "${workspaceFolder}/platform/tailoringexpert-db"
      },
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "db (demo)",
      "type": "shell",
      "command": "mvn",
      "args": [
        "install",
        "exec:exec@update",
        "-DskipTests"
      ],
      "options": {
        "cwd": "${workspaceFolder}/demo/tailoringexpert-db"
      },
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "db",
      "dependsOrder": "sequence",
      "dependsOn": [
        "db (delete)",
        "db (tailoringexpert)",
        "db (demo)"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}